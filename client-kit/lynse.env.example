# Config pessoal da Operação Lynse — fica em ~/.claude/lynse/.env
# Este arquivo NUNCA deve ser copiado para dentro de um repositório de cliente.

LYNSE_API_URL=https://lynse-control-plane.onrender.com
LYNSE_API_KEY=COLE_AQUI_SUA_CHAVE_PESSOAL

# Opcionais — normalmente não precisam ser definidos:
# LYNSE_MODE=audit
# LYNSE_CAPTURE_MODE=classified
# LYNSE_FAIL_MODE=open
# LYNSE_PROJECT_SLUG=   (por padrão é derivado do git remote do repositório aberto)
# LYNSE_REPOSITORY_SLUG=
