# Config pessoal da Operação Lynse — fica em ~/.claude/lynse/.env
# Este arquivo NUNCA deve ser copiado para dentro de um repositório de cliente.

LYNSE_API_URL=https://lynse-control-plane.onrender.com
LYNSE_API_KEY=COLE_AQUI_SUA_CHAVE_PESSOAL

# Opcionais — normalmente não precisam ser definidos:
# LYNSE_MODE=audit
# LYNSE_CAPTURE_MODE=classified
# LYNSE_FAIL_MODE=open
# LYNSE_PROJECT_SLUG=   (por padrão é derivado do git remote do repositório aberto)
# LYNSE_REPOSITORY_SLUG=

# Este arquivo só é lido pelos hooks/skills da Operação Lynse, não pelo processo
# "claude" em si. Para o dashboard mostrar tokens/custo, o processo do Claude Code
# precisa das variáveis abaixo no PRÓPRIO shell (perfil do PowerShell/.zshrc/.bashrc),
# não aqui. Veja o passo opcional de telemetria no SETUP_PROMPT.md.
#
# CLAUDE_CODE_ENABLE_TELEMETRY=1
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://lynse-control-plane.onrender.com/otel/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<sua LYNSE_API_KEY pessoal>
# OTEL_METRICS_INCLUDE_SESSION_ID=true
