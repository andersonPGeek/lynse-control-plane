# Identidade e correlação da execução
LYNSE_API_URL=http://localhost:3333
LYNSE_API_KEY=change-me-local
LYNSE_PROJECT_SLUG=customer-portal
LYNSE_REPOSITORY_SLUG=customer-api
LYNSE_ABE_EMAIL=anderson@lynse.ai
LYNSE_MODE=audit
LYNSE_CAPTURE_MODE=classified
LYNSE_FAIL_MODE=open

# Telemetria nativa do Claude Code via OTLP/HTTP JSON
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:3333/otel/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3333/otel/v1/logs
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=change-me-local
OTEL_METRICS_INCLUDE_SESSION_ID=true

# POC segura por padrão: não exporta conteúdo bruto pelo OpenTelemetry.
OTEL_LOG_USER_PROMPTS=0
OTEL_LOG_ASSISTANT_RESPONSES=0
OTEL_LOG_TOOL_DETAILS=0

